# Node / extension build
node_modules/
extension/node_modules/
# The built model runner (offscreen/offscreen.bundle.js) and the ONNX runtime (vendor/ort/) are
# committed on purpose so a plain download works without Node. Rebuild with `npm run build:llm`.
extension/offscreen/ort-wasm-simd-threaded.jsep.mjs
extension/offscreen/ort-wasm-simd-threaded.jsep.wasm

# Playwright leaves a full Chrome profile behind after a test run (~34 MB, ~950 files)
extension/test/.pw-profile/
test-results/
playwright-report/

# Browser profiles and local run state
browser_profile/
screenshots/

# Python (legacy CLI)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local data and secrets
.env
data/
*.db

# OS / editor
.DS_Store
Thumbs.db
desktop.ini

