{
  "manifest_version": 3,
  "name": "Luma Agent",
  "version": "1.4.0",
  "description": "Scan curated SF event sources and auto-register for Luma events",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://lu.ma/*",
    "https://luma.com/*",
    "https://api2.luma.com/*",
    "https://cerebralvalley.ai/*",
    "https://*.cerebralvalley.ai/*",
    "https://bayareafoundersclub.substack.com/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs-us-1.huggingface.co/*",
    "https://cdn-lfs-eu-1.huggingface.co/*",
    "https://api.openai.com/*",
    "http://127.0.0.1:9090/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/ort/*",
        "offscreen/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Luma Agent panel"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lu.ma/*",
        "https://luma.com/*"
      ],
      "js": [
        "lib/run-control-content.js",
        "lib/form-intelligence.js",
        "lib/form-scanner.js",
        "lib/form-agent.js",
        "lib/visual-cursor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cerebralvalley.ai/*"
      ],
      "js": [
        "lib/cv-discovery.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
